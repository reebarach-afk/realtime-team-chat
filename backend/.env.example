SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave REDIS_HOST empty to use the in-memory channel layer (single process only).
# Set it to localhost when Redis is running (docker run -d -p 6379:6379 redis:7)
REDIS_HOST=
REDIS_PORT=6379

# Leave DB_NAME empty to use SQLite. Fill these in for PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
